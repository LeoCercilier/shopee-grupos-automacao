# Fonte de ofertas (pública)
SUPABASE_URL=https://ajjbtuhnvdehcxqykfkf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UD6ktmFQ0yW9fVIHRH7EVQ_gGsn5Al4
COLETOR_LIMIT=40

# Publicação Graph API (Página) — DESLIGADA; Groups API removida pela Meta
PUBLICAR=false
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Agente de navegador (Playwright) — uso LOCAL ---
# preparar = preenche o compositor e NÃO clica em Publicar (padrão)
# publicar = tenta clicar em Publicar e só grava histórico se confirmar
MODO_PUBLICACAO_BROWSER=preparar

# true = não abre o navegador (só valida seleção)
BROWSER_DRY_RUN=false

# false = janela visível (recomendado no MVP)
BROWSER_HEADLESS=false

# Opcional: forçar um grupo específico no teste 1×1
# BROWSER_GRUPO_ID=987613641743046
# BROWSER_GRUPO_INTERNO=grupo-geral-1

# Navegador Playwright / COGO
BROWSER_HEADLESS=false

# Se o Chromium estiver em um caminho específico, informe aqui.
# Exemplo:
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Use true somente se o Chromium do COGO exigir execução sem sandbox.
BROWSER_NO_SANDBOX=false


# --- Conversão de links afiliados (navegador / Portal Shopee) ---
# URL da página "Link de Conversão" ou "Link personalizado" no Portal.
# Obrigatória para npm run afiliados:converter
# SHOPEE_CONVERSAO_URL=https://affiliate.shopee.com.br/...

# true = executa conversão no pipeline antes da publicação
AFILIADOS_CONVERTER=false

# true = preenche a página mas NÃO clica em Converter
SHOPEE_CONVERSAO_DRY_RUN=false

# Publicador Playwright (grupos) — use no ambiente LOCAL com sessão .browser-session/
# PUBLICADOR=navegador

# Sessão Playwright para CI (GitHub Actions). NÃO versionar o conteúdo.
# Gere localmente após login: storageState JSON → base64.
# Ex.: node -e "console.log(require('fs').readFileSync('storage-state.json').toString('base64'))"
# BROWSER_STORAGE_STATE_B64=

# Exigir link afiliado confirmado no publicador navegador (padrão: true)
# EXIGIR_LINK_AFILIADO=true
